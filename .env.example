# Copy to .env and adjust if needed. No real secrets — local dev only.
POSTGRES_USER=studioflow
POSTGRES_PASSWORD=studioflow
POSTGRES_DB=studioflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host-side published port (container always listens on 5432 internally).
# 5434 avoids clashing with a native/local PostgreSQL install on 5432.
POSTGRES_HOST_PORT=5434
